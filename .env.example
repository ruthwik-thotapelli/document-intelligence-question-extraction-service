# --- API Settings ---
PROJECT_NAME="Document Intelligence API"
ENVIRONMENT=production
SECRET_KEY=pragati_bharati_super_secret_key_2026_eval

# --- Database & Message Broker (Docker Mode) ---
# Note: If running locally without Docker, the app automatically falls back
# to a local SQLite database (local.db) and synchronous Celery execution!
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intel
REDIS_URL=redis://redis:6379/0

# --- AI Extraction Engine ---
# [OPTIONAL FOR RECRUITERS]: If you do not provide a Gemini API Key, the 
# system will gracefully fall back to a "Mock AI Generator" so you can 
# still evaluate the asynchronous architecture, DB persistence, and UI flow!
GEMINI_API_KEY=your_gemini_api_key_here
